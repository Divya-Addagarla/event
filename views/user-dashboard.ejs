<link rel="stylesheet" href="/css/style.css">
<div class="sidebar">
    <h2>Student Portal</h2>
    <button onclick="location.href='/registered-events'">My Registrations</button>
    <button onclick="location.href='/'">Logout</button>
</div>

<div class="content">
    <h3>Upcoming Events</h3>
    <div id="events-grid"></div>
</div>

<script type="module">
    import { db, auth, getDocs, collection, addDoc, updateDoc, doc, increment } from "/js/firebase-config.js";

    const snap = await getDocs(collection(db, "events"));
    snap.forEach(d => {
        const ev = d.data();
        const seats = ev.capacity - ev.registeredCount;
        document.getElementById('events-grid').innerHTML += `
            <div class="event-card">
                <h4>${ev.name}</h4>
                <p>${ev.date} at ${ev.time}</p>
                <p>Seats: ${seats}</p>
                <button onclick="reg('${d.id}', '${seats}')" ${seats <= 0 ? 'disabled' : ''}>Register</button>
            </div>
        `;
    });

