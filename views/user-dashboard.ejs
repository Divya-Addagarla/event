// Inside the <script type="module"> of user-dashboard.ejs
window.reg = async (id, seats) => {
    const email = prompt("Confirm Email to Register:");
    const pass = prompt("Confirm Password:");
    
    if(email && pass) {
        try {
            // 1. Add registration record
            await addDoc(collection(db, "registrations"), { 
                eventId: id, 
                userEmail: email 
            });

            // 2. Update the event count
            await updateDoc(doc(db, "events", id), { 
                registeredCount: increment(1) 
            });

            // 3. Display Thank You message
            alert("Thank you for your registration!"); 
            
            location.reload();
        } catch (error) {
            alert("Error during registration: " + error.message);
        }
    }
};


</script>